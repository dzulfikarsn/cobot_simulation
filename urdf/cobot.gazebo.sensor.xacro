<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

  <!-- ini merupakan file xacro tetapi nama tagnya tidak umum.
       sebenarnya tag-tag ini bukan milik urdf/xacro tetapi milik sdf/gazebo
       file ini akan diubah oleh gz menjadi format sdf
       penghubung antara frame yang ada di urdf dengan frame di sdf adalah <gazebo reference="...">
  -->

  <xacro:macro name="imu_sensor" params="frame_id name">
    <gazebo reference="${frame_id}">
      <sensor name="${name}" type="imu">
        <topic>sensor/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>

        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise></z>
          </linear_acceleration>
        </imu>

      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="range_sensor" params="frame_id name">
    <gazebo reference="${frame_id}">
      <sensor name="${name}" type="gpu_lidar">
        <update_rate>10</update_rate>
        <topic>sensor/${name}</topic>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>2.0</max>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="camera_sensor" params="frame_id name">
    <gazebo reference="${frame_id}">
      <sensor name="${name}" type="camera">
        <topic>sensor/camera/image</topic>
        <update_rate>30</update_rate>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <lens>
            <type>pinhole</type>
          </lens>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>